# Supabase > Project Settings > Database > Connection string > "Transaction pooler" (포트 6543) 주소
DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 아무 긴 무작위 문자열 (IP 해시·운영자 쿠키 서명용). 예: openssl rand -base64 32
SESSION_SECRET=

# /admin 에 들어갈 운영자 비밀번호
ADMIN_PASSWORD=

# Vercel Cron 보호용 (Vercel이 자동으로 Authorization 헤더에 넣어 줌)
CRON_SECRET=

# 파일럿 데이터 삭제 예정일 (YYYY-MM-DD). 비우면 배너가 안 보여요
PILOT_DELETE_DATE=2026-12-11
